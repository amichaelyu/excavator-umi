# Data
# Recorded episodes live outside version control.
/dataset/
*.partial

# Secrets and per-machine settings (the *.example.json next to each one is its template)
.env
.env.*
.secrets/
*service-account*.json
configs/hub/local.json
configs/hub/local_checkpoints.json
configs/hardware/hardware_map.json
configs/hardware/camera-calibration/camera.json
configs/hardware/robot_full4_calibrated.json

# Local runtime output
hub/logs/
artifacts/
MUJOCO_LOG.TXT
*.lfstmp

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.cache/

# JavaScript
node_modules/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# camera calibration raw outputs, one folder per recording (camchain, results, views); camera.json next to them holds the values
configs/hardware/camera-calibration/*/

# twin link meshes (keep even where a global gitignore excludes *.obj)
!digital_twin/sim/assets/links/*.obj
