# Build context for policy/processing/docker/Dockerfile is the repository root: only the lockfile, configs/hardware/camera-calibration/camera.json (the camera model; per machine, from camera.example.json), policy/data/ (the
# stdlib data_root that policy.processing.slam.recording imports) and policy/processing/.
*
!pyproject.toml
!uv.lock
!.python-version
!configs/hardware/camera-calibration/camera*.json
!policy/data/
!policy/processing/
policy/data/tests/
policy/data/**/__pycache__/
policy/processing/**/__pycache__/
policy/processing/**/*.pyc
policy/processing/**/.pytest_cache/
policy/processing/**/.DS_Store
